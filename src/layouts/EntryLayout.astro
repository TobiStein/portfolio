---
import katexStylesheet from 'katex/dist/katex.min.css?url'
import { Image } from 'astro:assets'
import type { MarkdownHeading } from 'astro'

import BaseLayout from './BaseLayout.astro'
import Comment from '@/components/Comment.astro'
import Mermaid from '@/components/Mermaid.astro'
import Pageview from '@/components/Pageview.astro'
import ProjectLinks from '@/components/ProjectLinks.astro'
import TOC from '@/components/TOC.astro'
import { LOCALE_META, localePath, useTranslations, type Locale } from '@/i18n'
import { config } from '@/site-config'
import { entryUrl, getPosts, getProjects, type Entry } from '@/utils/server'

interface Props {
  /** A blog post or a project */
  entry: Entry
  lang: Locale
  headings: MarkdownHeading[]
  minutesRead: number
  hasMath?: boolean
  /** Base-aware URLs of this entry in every language it exists in */
  alternates?: Partial<Record<Locale, string>>
}

const { entry, lang, headings, minutesRead, hasMath = false, alternates } = Astro.props
const { t, date } = useTranslations(lang)
const { data } = entry
const published = data.publishDate
const updated = data.updatedDate

const isProject = entry.collection === 'projects'
const section = `/${entry.collection}`
const repo = entry.collection === 'projects' ? entry.data.repo : undefined
const demo = entry.collection === 'projects' ? entry.data.demo : undefined
// Comments are for blog posts only
const showComments = entry.collection === 'blog' && entry.data.comment

const text = isProject
  ? { back: t('projects.back'), end: t('projects.end'), nav: t('projects.nav') }
  : { back: t('blog.back'), end: t('blog.end'), nav: t('blog.nav') }

// Neighbour entries of the same collection and language (newer / older by publish date)
const siblings: Entry[] = isProject ? await getProjects(lang) : await getPosts(lang)
const index = siblings.findIndex((item) => item.id === entry.id)
const newer = index > 0 ? siblings[index - 1] : undefined
const older = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined

const canonical = new URL(entryUrl(entry), Astro.site ?? 'https://example.com')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isProject ? 'CreativeWork' : 'BlogPosting',
  headline: data.title,
  ...(isProject ? { name: data.title } : {}),
  description: data.description,
  inLanguage: LOCALE_META[lang].intl,
  datePublished: published.toISOString(),
  ...(updated ? { dateModified: updated.toISOString() } : {}),
  ...(data.tags.length > 0 ? { keywords: data.tags.join(', ') } : {}),
  author: { '@type': 'Person', name: config.site.author },
  mainEntityOfPage: canonical.href
}
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.description}
  date={published}
  modifiedDate={updated}
  stylesheets={hasMath ? [katexStylesheet] : []}
  alternates={alternates}
  fallbackPath={section}
>
  <!-- Reading progress -->
  <div id="reading-progress" aria-hidden="true"></div>

  <div
    class="max-w-[46rem] xl:grid xl:max-w-none xl:grid-cols-[minmax(0,46rem)_minmax(0,13rem)] xl:justify-between xl:gap-x-16"
  >
    <TOC {headings} lang={lang} />

    <article class="min-w-0 xl:col-start-1 xl:row-start-1">
      <!-- Entry header -->
      <header class="entry-head mb-10" data-thermal-shield data-reveal>
        <a href={localePath(lang, section)} class="entry-back" data-astro-prefetch>
          <span class="i-lucide-arrow-left size-3.5" aria-hidden="true"></span>
          {text.back}
        </a>
        <h1 class="entry-heading">
          {data.draft && <span class="me-2 text-accent">[{t('entry.draft')}]</span>}
          {data.title}
        </h1>

        <!-- Meta row: date, reading time, views -->
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-soft">
          <span class="inline-flex items-center gap-1.5">
            <span class="i-lucide-calendar size-3.5" aria-hidden="true"></span>
            <time datetime={published.toISOString()}>{date(published)}</time>
          </span>
          {
            updated && (
              <span class="inline-flex items-center gap-1.5">
                <span class="i-lucide-refresh-cw size-3.5" aria-hidden="true" />
                {t('entry.updated', { date: date(updated) })}
              </span>
            )
          }
          <span class="inline-flex items-center gap-1.5">
            <span class="i-lucide-clock size-3.5" aria-hidden="true"></span>
            {t('entry.readingTime', { minutes: minutesRead })}
          </span>
          {config.pageview.server && <Pageview lang={lang} />}
        </div>
        {
          data.tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap items-center gap-1.5" aria-label={t('entry.tags')}>
              {data.tags.map((tag) => (
                <li class="tag-pill">{tag}</li>
              ))}
            </ul>
          )
        }

        <!-- Project links (source code / live demo) -->
        <ProjectLinks lang={lang} repo={repo} demo={demo} variant="chip" class="mt-6" />
      </header>

      <!-- Cover image (optimized: responsive sizes, eager for LCP, no CLS) -->
      {
        data.heroImage && (
          <Image
            src={data.heroImage.src}
            alt={data.heroImage.alt ?? data.title}
            widths={[640, 960, 1280]}
            sizes="(min-width: 784px) 736px, (min-width: 640px) calc(100vw - 64px), calc(100vw - 40px)"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="entry-cover mb-10 h-auto max-h-[28rem] w-full rounded-2xl border border-line object-cover"
          />
        )
      }

      <!-- Entry body -->
      <div class="prose prose-fill" data-thermal-shield>
        <slot />
      </div>
      <Mermaid />

      <!-- Entry footer -->
      <footer class="not-prose mt-14 border-t border-line pt-6" data-thermal-shield>
        <p class="text-sm text-ink-soft">{text.end}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a href={localePath(lang, section)} class="chip" data-astro-prefetch>
            <span class="i-lucide-arrow-left size-3.5" aria-hidden="true"></span>
            {text.back}
          </a>
          <a href="#top" class="chip">
            <span class="i-lucide-arrow-up size-3.5" aria-hidden="true"></span>
            {t('entry.backToTop')}
          </a>
        </div>

        <!-- Newer / older -->
        {
          (newer || older) && (
            <nav class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2" aria-label={text.nav}>
              {newer && (
                <a
                  href={entryUrl(newer)}
                  class="paper-card group flex flex-col gap-1 p-4"
                  data-astro-prefetch
                >
                  <span class="flex items-center gap-1.5 text-xs text-ink-soft">
                    <span
                      class="i-lucide-arrow-left size-3.5 transition-transform duration-300 group-hover:-translate-x-1"
                      aria-hidden="true"
                    />
                    {t('entry.previous')}
                  </span>
                  <span class="line-clamp-2 text-sm font-medium group-hover:text-accent">
                    {newer.data.title}
                  </span>
                </a>
              )}
              {older && (
                <a
                  href={entryUrl(older)}
                  class="paper-card group flex flex-col gap-1 p-4 sm:text-end"
                  data-astro-prefetch
                >
                  <span class="flex items-center justify-end gap-1.5 text-xs text-ink-soft sm:flex-row-reverse">
                    <span
                      class="i-lucide-arrow-right size-3.5 transition-transform duration-300 group-hover:translate-x-1"
                      aria-hidden="true"
                    />
                    {t('entry.next')}
                  </span>
                  <span class="line-clamp-2 text-sm font-medium group-hover:text-accent">
                    {older.data.title}
                  </span>
                </a>
              )}
            </nav>
          )
        }

        {showComments && <Comment lang={lang} />}
      </footer>
    </article>
  </div>

  <!-- Structured data (BlogPosting / CreativeWork) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  /* Reading progress: the heat scale fills up as you read */
  #reading-progress {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    height: 3px;
    background: var(--thermal-gradient);
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }

  .entry-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--ink-soft) / 1);
    transition: color 0.2s ease;
  }
  .entry-back:hover {
    color: hsl(var(--accent) / 1);
  }
  .entry-heading {
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 1.45rem + 1.9vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .entry-cover {
    box-shadow: 0 24px 60px -32px hsl(var(--decor) / 0.4);
  }
</style>

<script>
  const bar = document.getElementById('reading-progress')
  if (bar) {
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight
      bar.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
  }
</script>
