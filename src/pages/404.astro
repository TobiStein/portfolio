---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { DEFAULT_LOCALE, LOCALES, localePath, useTranslations } from '@/i18n'

// The 404 page has no language of its own: show every language, default first.
const versions = LOCALES.map((lang) => {
  const { t } = useTranslations(lang)
  return {
    lang,
    title: t('notFound.title'),
    text: t('notFound.text'),
    back: t('notFound.back'),
    home: localePath(lang)
  }
})
const title = versions.map((version) => version.title).join(' / ')
---

<BaseLayout lang={DEFAULT_LOCALE} title={title} noindex alternates={{}}>
  <div class="lost not-prose">
    <div class="lost-copy" data-thermal-shield data-reveal>
      <p class="lost-code">404</p>
      <div class="flex flex-col gap-1">
        {
          versions.map((version) => (
            <p lang={version.lang} class="text-lg text-ink-soft">
              {version.text}
            </p>
          ))
        }
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        {
          versions.map((version) => (
            <a
              href={version.home}
              lang={version.lang}
              hreflang={version.lang}
              class="btn-hot"
              data-astro-prefetch
            >
              <span class="i-lucide-house size-4" aria-hidden="true" />
              {version.back}
            </a>
          ))
        }
      </div>
    </div>
    <div class="lost-butterfly" data-butterfly aria-hidden="true"></div>
  </div>
</BaseLayout>

<style>
  .lost {
    display: grid;
    align-items: center;
    gap: 2rem;
    min-height: min(calc(100svh - 14rem), 38rem);
  }
  .lost-code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3.5rem + 7vw, 8.5rem);
    font-weight: 400;
    line-height: 0.9;
    margin-bottom: 1.5rem;
  }
  .lost-butterfly {
    display: none;
  }
  @media (min-width: 1024px) {
    .lost {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .lost-butterfly {
      display: block;
      width: min(100%, 28rem);
      aspect-ratio: 6 / 5;
      justify-self: end;
    }
  }
</style>
