---
import type { GetStaticPaths } from 'astro'

import BaseLayout from '@/layouts/BaseLayout.astro'
import EntryCard from '@/components/EntryCard.astro'
import { localePath, localeStaticPaths, useTranslations, type Locale } from '@/i18n'
import { config } from '@/site-config'
import { socialLinks, withBase } from '@/utils'
import { getPosts, getProjects } from '@/utils/server'

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { t, pick } = useTranslations(lang)
const { hero, recentProjects, recentPosts } = config.home

const tagline = hero.tagline ? pick(hero.tagline).trim() : ''
const place = hero.location ? pick(hero.location).trim() : ''
// Short introduction: the hero summary, or the first paragraph of the biography
const summary = hero.summary ? pick(hero.summary).trim() : ''
const firstParagraph = pick(config.about.bio).trim().split(/\n\s*\n/)[0] ?? ''
const introduction = summary || firstParagraph.trim()

const projects = recentProjects > 0 ? (await getProjects(lang)).slice(0, recentProjects) : []
const posts = recentPosts > 0 ? (await getPosts(lang)).slice(0, recentPosts) : []
const social = socialLinks(config.footer.social)
---

<BaseLayout lang={lang}>
  <div class="mx-auto max-w-[47.5rem]">
    <!-- Hero -->
    <div id="content-header" class="animate not-prose mb-12 border-b border-line pb-10">
      <div class="flex items-center gap-4 sm:gap-5">
        {
          config.site.avatar && (
            <img
              src={withBase(config.site.avatar)}
              alt={config.site.author}
              width="72"
              height="72"
              loading="eager"
              decoding="async"
              class="size-16 shrink-0 rounded-full border border-line object-cover sm:size-18"
            />
          )
        }
        <div class="min-w-0">
          <h1 class="font-serif text-3xl font-semibold leading-tight text-ink sm:text-4xl">
            {config.site.author}
          </h1>
          {
            tagline && (
              <p class="mt-2 text-xs leading-relaxed tracking-wide text-ink-soft sm:text-sm">
                {tagline}
              </p>
            )
          }
        </div>
      </div>

      {
        introduction && (
          <div class="mt-5 max-w-2xl space-y-3 text-base leading-relaxed text-ink-soft">
            {introduction
              .split(/\n\s*\n/)
              .filter(Boolean)
              .map((paragraph) => (
                <p>{paragraph}</p>
              ))}
          </div>
        )
      }

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        {
          place && (
            <span class="inline-flex items-center gap-1 text-sm text-ink-soft">
              <span class="i-lucide-map-pin size-3.5" aria-hidden="true" />
              {place}
            </span>
          )
        }
        {
          social.map((item) => {
            const external = !item.url.startsWith('mailto:')
            return (
              <a
                href={item.url}
                target={external ? '_blank' : undefined}
                rel={external ? 'noreferrer' : undefined}
                aria-label={item.label}
                title={item.label}
                class="icon-link size-9"
              >
                <span class={`${item.icon} size-4`} aria-hidden="true" />
              </a>
            )
          })
        }
        <a
          href={localePath(lang, '/about')}
          class="link-ink inline-flex min-h-9 items-center text-sm"
          data-astro-prefetch
        >
          {t('home.moreAbout')}
        </a>
      </div>
    </div>

    <!-- Recent projects -->
    {
      projects.length > 0 && (
        <section
          aria-labelledby="home-projects"
          class="animate not-prose mb-16"
          style="animation-delay: 60ms"
        >
          <div class="mb-5 flex items-end justify-between gap-4">
            <h2 id="home-projects" class="font-serif text-xl font-normal">
              {t('home.projects')}
            </h2>
            <a href={localePath(lang, '/projects')} class="link-ink text-sm" data-astro-prefetch>
              {t('home.allProjects')}
            </a>
          </div>
          <div class="flex flex-col">
            {projects.map((project) => (
              <EntryCard entry={project} lang={lang} />
            ))}
          </div>
        </section>
      )
    }

    <!-- Recent posts -->
    {
      posts.length > 0 && (
        <section
          aria-labelledby="home-posts"
          class="animate not-prose mb-16"
          style="animation-delay: 120ms"
        >
          <div class="mb-5 flex items-end justify-between gap-4">
            <h2 id="home-posts" class="font-serif text-xl font-normal">
              {t('home.posts')}
            </h2>
            <a href={localePath(lang, '/blog')} class="link-ink text-sm" data-astro-prefetch>
              {t('home.allPosts')}
            </a>
          </div>
          <div class="flex flex-col">
            {posts.map((post) => (
              <EntryCard entry={post} lang={lang} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
