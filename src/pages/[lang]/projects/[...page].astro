---
import type { GetStaticPaths, Page } from 'astro'

import BaseLayout from '@/layouts/BaseLayout.astro'
import EntryCard from '@/components/EntryCard.astro'
import PageHeader from '@/components/PageHeader.astro'
import Pagination from '@/components/Pagination.astro'
import { LOCALES, useTranslations, type Locale } from '@/i18n'
import { config } from '@/site-config'
import { getProjects, type Project } from '@/utils/server'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const pages = await Promise.all(
    LOCALES.map(async (lang) =>
      paginate(await getProjects(lang), {
        pageSize: config.projects.pageSize,
        params: { lang },
        props: { lang }
      })
    )
  )
  return pages.flat()
}) satisfies GetStaticPaths

interface Props {
  page: Page<Project>
  lang: Locale
}

const { page, lang } = Astro.props
const { t, tn } = useTranslations(lang)
const isFirst = page.currentPage === 1
const totalPages = Math.max(1, page.lastPage)
const pageLabel = t('pagination.page', { page: page.currentPage, total: totalPages })
const title = isFirst
  ? t('projects.title')
  : `${t('projects.title')}${config.site.titleDelimiter}${pageLabel}`

// Page 1 exists in every language; later pages may not exist in the other one.
const alternates: Partial<Record<Locale, string>> | undefined = isFirst
  ? undefined
  : { [lang]: Astro.url.pathname }
---

<BaseLayout
  lang={lang}
  title={title}
  description={t('projects.description')}
  alternates={alternates}
  fallbackPath="/projects"
>
  <PageHeader title={t('projects.title')} subtitle={t('projects.description')}>
    <p class="mt-3 text-sm font-medium text-meta">
      {tn('projects.count', page.total)}{totalPages > 1 && <span class="text-ink-soft">, {pageLabel}</span>}
    </p>
  </PageHeader>

  <div class="not-prose max-w-[46rem]" data-thermal-shield>
    {
      page.data.length === 0 ? (
        <p class="py-12 text-ink-soft">{t('projects.empty')}</p>
      ) : (
        <div class="flex flex-col">
          {page.data.map((project) => (
            <EntryCard entry={project} lang={lang} />
          ))}
        </div>
      )
    }

    <Pagination
      prev={page.url.prev ? { title: t('pagination.previous'), url: page.url.prev } : undefined}
      next={page.url.next ? { title: t('pagination.next'), url: page.url.next } : undefined}
    />
  </div>
</BaseLayout>
