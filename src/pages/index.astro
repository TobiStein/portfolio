---
// Site root: send visitors to their language (saved choice, then browser
// languages, then the default language). Not indexed, no site chrome.
import { DEFAULT_LOCALE, LOCALE_STORAGE_KEY, LOCALES, localePath, type Locale } from '@/i18n'
import { config } from '@/site-config'
import { withBase } from '@/utils'

// Each language written in its own language (endonyms)
const LANGUAGE_NAMES: Record<Locale, string> = { fr: 'Français', en: 'English' }

const homes = Object.fromEntries(LOCALES.map((lang) => [lang, localePath(lang)])) as Record<
  Locale,
  string
>
const fallbackHome = homes[DEFAULT_LOCALE]
const redirect = {
  homes,
  locales: [...LOCALES] as string[],
  storageKey: LOCALE_STORAGE_KEY,
  defaultLang: DEFAULT_LOCALE as string
}
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{config.site.title}</title>
    <link rel="icon" href={withBase(config.site.favicon)} sizes="any" />
    <script is:inline define:vars={{ redirect }}>
      let lang
      try {
        const saved = localStorage.getItem(redirect.storageKey)
        if (redirect.locales.includes(saved)) lang = saved
      } catch {
        // Storage unavailable (private mode, blocked cookies…)
      }
      if (!lang) {
        const preferred = navigator.languages?.length ? navigator.languages : [navigator.language]
        lang = preferred
          .map((tag) => String(tag || '').slice(0, 2).toLowerCase())
          .find((code) => redirect.locales.includes(code))
      }
      const home = redirect.homes[lang || redirect.defaultLang]
      location.replace(home + location.search + location.hash)
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${fallbackHome}`} /></noscript>
    <style is:global>
      :root {
        color-scheme: light dark;
      }
      body {
        display: grid;
        min-height: 100dvh;
        margin: 0;
        place-items: center;
        background: Canvas;
        color: CanvasText;
        font-family: system-ui, sans-serif;
      }
      ul {
        display: flex;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      a {
        color: inherit;
        text-underline-offset: 4px;
      }
    </style>
  </head>
  <body>
    <main>
      <ul>
        {
          LOCALES.map((lang) => (
            <li>
              <a href={homes[lang]} hreflang={lang} lang={lang}>
                {LANGUAGE_NAMES[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
