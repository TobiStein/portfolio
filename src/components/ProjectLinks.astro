---
import { useTranslations, type Locale } from '@/i18n'
import { cn } from '@/utils'

interface Props {
  lang: Locale
  /** Source code URL */
  repo?: string
  /** Live demo URL */
  demo?: string
  /** `icon`: round icon-only buttons (cards) · `chip`: pill buttons with text (project page) */
  variant?: 'icon' | 'chip'
  class?: string
}

const { lang, repo, demo, variant = 'icon', class: className } = Astro.props
const { t } = useTranslations(lang)

interface ProjectLink {
  url: string
  label: string
  icon: string
}

function repoIcon(url: string): string {
  if (/github\.com/i.test(url)) return 'i-lucide-github'
  if (/gitlab\./i.test(url)) return 'i-lucide-gitlab'
  return 'i-lucide-code'
}

const links: ProjectLink[] = []
if (repo) links.push({ url: repo, label: t('projects.repo'), icon: repoIcon(repo) })
if (demo) links.push({ url: demo, label: t('projects.demo'), icon: 'i-lucide-external-link' })

const isChip = variant === 'chip'
---

{
  links.length > 0 && (
    <div
      class={cn(
        'not-prose flex flex-wrap items-center',
        isChip ? 'gap-3' : 'gap-2',
        className
      )}
    >
      {links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noreferrer"
          class={
            isChip
              ? 'chip !px-3 !py-1 text-sm hover:!border-accent/50 hover:!text-accent'
              : 'inline-flex size-8 items-center justify-center rounded-full border border-line bg-wash text-ink-soft transition-colors duration-200 hover:border-accent/50 hover:text-accent'
          }
          aria-label={isChip ? undefined : link.label}
          title={isChip ? undefined : link.label}
        >
          <span class={cn(link.icon, isChip ? 'size-3.5' : 'size-4')} aria-hidden="true" />
          {isChip && link.label}
        </a>
      ))}
    </div>
  )
}
