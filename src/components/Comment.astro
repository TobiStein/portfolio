---
import { LOCALE_META, useTranslations, type Locale } from '@/i18n'
import { config } from '@/site-config'
import { withBase } from '@/utils'

// Waline stylesheet + our overrides live together in waline.css (import
// order guarantees our rules win) — see src/assets/styles/waline.css
import walineStylesheet from '@/assets/styles/waline.css?url'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { t } = useTranslations(lang)

const server = config.comment.server
const enabled = config.comment.provider === 'waline' && server !== ''
---

{
  enabled && (
    <section class="not-prose mt-14" aria-label={t('comments.title')}>
      <link rel="stylesheet" href={walineStylesheet} />
      <h2 class="mb-4 flex items-center gap-2 font-serif text-lg font-semibold">
        <span class="i-lucide-message-square size-4 text-accent" aria-hidden="true" />
        {t('comments.title')}
      </h2>
      <div
        id="waline"
        data-server={server}
        data-lang={LOCALE_META[lang].intl}
        data-reaction={withBase('/icons/heart-item.svg')}
        data-reaction-label={t('comments.reaction')}
        data-reaction-title={t('comments.reactionTitle')}
        data-placeholder={t('comments.placeholder')}
      />
    </section>
  )
}

<script>
  const target = document.getElementById('waline')

  // Lazy-load Waline: initialize only when the comment section approaches the
  // viewport — saves ~190 KB of JS on the first paint of every post page.
  const initComment = async (el: HTMLElement) => {
    const { init } = await import('@waline/client')
    const { server = '', lang, reaction = '', reactionLabel, reactionTitle, placeholder } =
      el.dataset
    init({
      el,
      serverURL: server,
      // Waline's built-in strings in the page language ('fr-FR' / 'en-US')
      lang,
      // page views are handled by the separate <Pageview /> component
      pageview: false,
      imageUploader: false,
      // Single heart "like" reaction — styling lives in waline.css
      reaction: [reaction],
      locale: {
        ...(reactionLabel ? { reaction0: reactionLabel } : {}),
        ...(reactionTitle ? { reactionTitle } : {}),
        ...(placeholder ? { placeholder } : {})
      }
    })
  }

  if (target?.dataset.server) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect()
          initComment(target)
        }
      },
      { rootMargin: '600px 0px' }
    )
    observer.observe(target)
  }
</script>
