---
import { LOCALE_META, useTranslations, type Locale } from '@/i18n'
import { config } from '@/site-config'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { t } = useTranslations(lang)

const server = config.pageview.server
const enabled = config.pageview.siteWide
// Fixed virtual path — one counter for the whole site (total PV), shared by all languages.
const SITE_PATH = '/site-pv'
---

{
  server && enabled && (
    <span
      class="site-pv inline-flex items-center gap-1 text-xs"
      data-server={server}
      data-path={SITE_PATH}
      data-locale={LOCALE_META[lang].intl}
      data-unavailable={t('pageview.unavailableShort')}
      data-unavailable-title={t('pageview.unavailable')}
    >
      <span class="site-pv-num" data-pageview-value aria-label={t('pageview.total')}>
        ···
      </span>
      <span class="site-pv-unit">{t('pageview.total')}</span>
    </span>
  )
}

<script>
  import { updatePageview } from '@/utils/pageview'

  void updatePageview(document.querySelector<HTMLElement>('.site-pv'))
</script>
