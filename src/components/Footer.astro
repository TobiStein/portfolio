---
import SitePageview from '@/components/SitePageview.astro'
import { localePath, useTranslations, type Locale } from '@/i18n'
import { config } from '@/site-config'
import { socialLinks, withBase } from '@/utils'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const { t, pick } = useTranslations(lang)

const year = new Date().getFullYear()
const copyright = config.footer.copyright ?? `© ${year} ${config.site.author}`
const footerLinks = (config.footer.links ?? []).map((link) => ({
  title: pick(link.title),
  // Files under public/ need the base; external URLs pass through
  url: withBase(link.url)
}))
const socialItems = socialLinks(config.footer.social).map((item) => ({
  ...item,
  external: /^https?:\/\//.test(item.url)
}))
const footerLink =
  'inline-flex min-h-8 items-center underline-offset-4 transition-colors hover:text-accent hover:underline focus-visible:text-accent focus-visible:underline'
---

<footer class="site-footer not-prose" data-thermal-shield>
  <div class="footer-row">
    <p class="footer-copy">{copyright}</p>

    <div class="footer-links">
      {
        (footerLinks.length > 0 || config.footer.rss) && (
          <nav aria-label={t('footer.links')} class="flex flex-wrap items-center gap-x-4 gap-y-1">
            {footerLinks.map((link) => (
              <a href={link.url} class={footerLink}>
                {link.title}
              </a>
            ))}
            {config.footer.rss && (
              <a href={localePath(lang, '/rss.xml')} class={`${footerLink} gap-1.5`}>
                <span class="i-lucide-rss size-3.5" aria-hidden="true" />
                RSS
              </a>
            )}
          </nav>
        )
      }
      <span>
        {t('footer.poweredBy')} <a
          href="https://astro.build"
          target="_blank"
          rel="noreferrer"
          class={footerLink}>Astro</a
        >
      </span>
      <SitePageview lang={lang} />
      {
        socialItems.length > 0 && (
          <nav aria-label={t('footer.social')} class="flex items-center gap-0.5">
            {socialItems.map((item) => (
              <a
                href={item.url}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noreferrer' : undefined}
                aria-label={item.label}
                title={item.label}
                class="inline-flex size-8 items-center justify-center rounded-md transition-colors hover:bg-wash hover:text-accent focus-visible:text-accent"
              >
                <span class={`${item.icon} size-4`} aria-hidden="true" />
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid hsl(var(--line) / 1);
    padding-block: 1.6rem 2rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: hsl(var(--ink-soft) / 1);
  }
  .footer-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-copy {
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: hsl(var(--ink) / 1);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 1.25rem;
  }
  @media (min-width: 640px) {
    .footer-row {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
