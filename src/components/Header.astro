---
import {
  LOCALE_META,
  LOCALE_STORAGE_KEY,
  localePath,
  otherLocale,
  useTranslations,
  type Locale
} from '@/i18n'
import { config } from '@/site-config'

interface Props {
  lang: Locale
  /** URL of this page in the other language (or a neutral fallback page) */
  switchHref: string
}

const { lang, switchHref } = Astro.props
const { t, pick } = useTranslations(lang)
const target = otherLocale(lang)
// Written in the target language, like the page it leads to
const switchLabel = useTranslations(target).t('lang.switchTo')

const trim = (path: string) => path.replace(/\/+$/, '')
const pathname = trim(Astro.url.pathname)
const menu = config.header.menu.map((item) => {
  const href = localePath(lang, item.link)
  const exact = pathname === trim(href)
  const inSection = item.link !== '/' && pathname.startsWith(`${trim(href)}/`)
  // 'page' on the section page itself, 'true' on the pages inside it (an article, page 2…)
  const current: 'page' | 'true' | undefined = exact ? 'page' : inSection ? 'true' : undefined
  return { title: pick(item.title), href, current }
})
---

<header class="site-header not-prose sticky top-0 z-40 w-full shrink-0" id="site-header">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-5 sm:px-8">
    <!-- Brand -->
    <a href={localePath(lang)} class="group flex items-center gap-2" aria-label={config.site.title}>
      <span
        class="i-lucide-feather text-lg text-accent transition-transform duration-300 group-hover:-rotate-12"
        aria-hidden="true"></span>
      <span class="font-serif text-lg font-semibold tracking-wide">{config.site.title}</span>
    </a>

    <!-- Nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label={t('nav.primary')}>
      {
        menu.map((item) => (
          <a
            href={item.href}
            aria-current={item.current}
            class={[
              'rounded-md px-3 py-1.5 text-sm transition-colors duration-200',
              item.current ? 'text-accent' : 'text-ink-soft hover:text-accent'
            ].join(' ')}
          >
            {item.title}
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-1">
      <a
        id="lang-toggle"
        href={switchHref}
        hreflang={target}
        lang={target}
        data-lang={target}
        data-storage-key={LOCALE_STORAGE_KEY}
        class="icon-btn lang-btn"
        title={switchLabel}
      >
        <span class="i-lucide-languages size-4" aria-hidden="true"></span>
        <span>{LOCALE_META[target].label}</span>
        <span class="sr-only"> – {switchLabel}</span>
      </a>

      <button
        id="palette-toggle"
        type="button"
        class="icon-btn"
        aria-label={t('header.palette')}
        title={t('header.palette')}
      >
        <span class="i-lucide-feather icon-ink size-5" aria-hidden="true"></span>
        <span class="i-lucide-leaf icon-fresh hidden size-5" aria-hidden="true"></span>
      </button>

      <button
        id="theme-toggle"
        type="button"
        class="icon-btn"
        aria-label={t('header.theme')}
        title={t('header.theme')}
      >
        <span class="i-lucide-monitor icon-system size-5" aria-hidden="true"></span>
        <span class="i-lucide-sun icon-light size-5" aria-hidden="true"></span>
        <span class="i-lucide-moon icon-dark size-5" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav: in normal flow (scrolls away), only the slim bar stays sticky -->
<nav
  class="mobile-nav not-prose mx-auto flex max-w-5xl gap-1 overflow-x-auto px-5 pb-2 sm:px-8 md:hidden"
  aria-label={t('nav.primary')}
>
  {
    menu.map((item) => (
      <a
        href={item.href}
        aria-current={item.current}
        class={[
          'flex-none rounded-md px-3 py-1 text-sm transition-colors duration-200',
          item.current ? 'text-accent' : 'text-ink-soft hover:text-accent'
        ].join(' ')}
      >
        {item.title}
      </a>
    ))
  }
</nav>

<style>
  /* Sticky bar: transparent at top, frosted paper once scrolled */
  .site-header {
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      backdrop-filter 0.25s ease;
    border-bottom: 1px solid transparent;
  }
  .site-header.scrolled {
    background-color: color-mix(in srgb, hsl(var(--paper) / 1) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: hsl(var(--line) / 1);
  }
  :global(.dark) .site-header.scrolled {
    background-color: color-mix(in srgb, hsl(var(--paper) / 1) 72%, transparent);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    color: hsl(var(--ink-soft) / 1);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .icon-btn:hover {
    color: hsl(var(--accent) / 1);
    background-color: hsl(var(--wash) / 1);
  }

  /* Language toggle: same look as the icon buttons, sized to its label */
  .lang-btn {
    width: auto;
    gap: 0.3rem;
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  /* Mobile nav row: scrollable, no visible scrollbar */
  .mobile-nav {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-nav::-webkit-scrollbar {
    display: none;
  }

  /* Theme icons: only the icon matching [data-theme] is shown */
  #theme-toggle .icon-system,
  #theme-toggle .icon-light,
  #theme-toggle .icon-dark {
    display: none;
  }

  :global(html[data-theme='light']) #theme-toggle .icon-light,
  :global(html[data-theme='dark']) #theme-toggle .icon-dark,
  :global(html[data-theme='system']) #theme-toggle .icon-system {
    display: inline-block;
  }

  /* Palette icons: feather (ink) by default, leaf (fresh) when active */
  :global(html[data-palette='fresh']) #palette-toggle .icon-ink {
    display: none;
  }
  :global(html[data-palette='fresh']) #palette-toggle .icon-fresh {
    display: inline-block;
  }
</style>

<script>
  const header = document.getElementById('site-header')
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  // Remember the language picked with the toggle (read by the root redirect)
  const langToggle = document.getElementById('lang-toggle')
  if (langToggle) {
    const { lang, storageKey } = langToggle.dataset
    langToggle.addEventListener('click', () => {
      if (!lang || !storageKey) return
      try {
        localStorage.setItem(storageKey, lang)
      } catch {
        // Switching still works when storage is unavailable.
      }
    })
  }
</script>
