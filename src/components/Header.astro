---
import {
  LOCALE_META,
  LOCALE_STORAGE_KEY,
  localePath,
  otherLocale,
  useTranslations,
  type Locale
} from '@/i18n'
import { config } from '@/site-config'

interface Props {
  lang: Locale
  /** URL of this page in the other language (or a neutral fallback page) */
  switchHref: string
}

const { lang, switchHref } = Astro.props
const { t, pick } = useTranslations(lang)
const target = otherLocale(lang)
// Written in the target language, like the page it leads to
const switchLabel = useTranslations(target).t('lang.switchTo')

const trim = (path: string) => path.replace(/\/+$/, '')
const pathname = trim(Astro.url.pathname)
const menu = config.header.menu.map((item) => {
  const href = localePath(lang, item.link)
  const exact = pathname === trim(href)
  const inSection = item.link !== '/' && pathname.startsWith(`${trim(href)}/`)
  // 'page' on the section page itself, 'true' on the pages inside it (an article, page 2…)
  const current: 'page' | 'true' | undefined = exact ? 'page' : inSection ? 'true' : undefined
  return { title: pick(item.title), href, current }
})
---

<header class="site-header not-prose sticky top-0 z-40 w-full shrink-0" id="site-header">
  <!-- data-thermal-shield="fixed": the ASCII field stays calm behind the bar, wherever the page is scrolled -->
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8"
    data-thermal-shield="fixed"
  >
    <!-- Brand: the name, in the pixel display face -->
    <a href={localePath(lang)} class="brand">
      {config.site.title}
    </a>

    <!-- Nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label={t('nav.primary')}>
      {
        menu.map((item) => (
          <a href={item.href} aria-current={item.current} class="nav-link">
            {item.title}
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-0.5">
      <a
        href={localePath(lang, '/search')}
        class="icon-btn"
        aria-label={t('search.title')}
        title={t('search.title')}
        aria-current={pathname === trim(localePath(lang, '/search')) ? 'page' : undefined}
        data-astro-prefetch
      >
        <span class="i-lucide-search size-[1.15rem]" aria-hidden="true"></span>
      </a>

      <a
        id="lang-toggle"
        href={switchHref}
        hreflang={target}
        lang={target}
        data-lang={target}
        data-storage-key={LOCALE_STORAGE_KEY}
        class="icon-btn lang-btn"
        title={switchLabel}
      >
        <span>{LOCALE_META[target].label}</span>
        <span class="sr-only"> – {switchLabel}</span>
      </a>

      <button
        id="palette-toggle"
        type="button"
        class="icon-btn"
        aria-label={t('header.palette')}
        title={t('header.palette')}
      >
        <span class="i-lucide-flame icon-fire size-[1.15rem]" aria-hidden="true"></span>
        <span class="i-lucide-waves icon-abyss size-[1.15rem]" aria-hidden="true"></span>
      </button>

      <button
        id="theme-toggle"
        type="button"
        class="icon-btn"
        aria-label={t('header.theme')}
        title={t('header.theme')}
      >
        <span class="i-lucide-monitor icon-system size-[1.15rem]" aria-hidden="true"></span>
        <span class="i-lucide-sun icon-light size-[1.15rem]" aria-hidden="true"></span>
        <span class="i-lucide-moon icon-dark size-[1.15rem]" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav: in normal flow (scrolls away), only the slim bar stays sticky -->
<nav
  class="mobile-nav not-prose mx-auto flex max-w-6xl gap-1 overflow-x-auto px-2 pb-1 sm:px-5 md:hidden"
  aria-label={t('nav.primary')}
  data-thermal-shield
>
  {
    menu.map((item) => (
      <a href={item.href} aria-current={item.current} class="nav-link flex-none">
        {item.title}
      </a>
    ))
  }
</nav>

<style>
  /* Sticky bar: transparent at top, frosted once scrolled (the ASCII field blurs behind it) */
  .site-header {
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      backdrop-filter 0.25s ease;
    border-bottom: 1px solid transparent;
  }
  .site-header.scrolled {
    background-color: color-mix(in srgb, hsl(var(--paper) / 1) 78%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom-color: hsl(var(--line) / 1);
  }

  /* Brand */
  .brand {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.01em;
    color: hsl(var(--ink) / 1);
    border-radius: 0.375rem;
    padding: 0.3rem 0.5rem;
    margin-inline-start: -0.5rem;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .brand:hover {
    background-color: hsl(var(--wash) / 1);
  }

  /* Navigation links: a tinted background on hover, like the icon buttons;
     the current section is underlined with the accent */
  .nav-link {
    position: relative;
    border-radius: 0.5rem;
    padding: 0.45rem 0.8rem;
    font-size: 0.925rem;
    font-weight: 500;
    color: hsl(var(--ink-soft) / 1);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: hsl(var(--hover-ink) / 1);
    background-color: hsl(var(--wash) / 1);
  }
  .nav-link[aria-current] {
    color: hsl(var(--ink) / 1);
  }
  .nav-link[aria-current]::after {
    content: '';
    position: absolute;
    inset-inline: 0.8rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: hsl(var(--accent) / 1);
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 0.5rem;
    color: hsl(var(--ink-soft) / 1);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .icon-btn:hover {
    color: hsl(var(--hover-ink) / 1);
    background-color: hsl(var(--wash) / 1);
  }

  /* Language toggle: same look as the icon buttons, sized to its label */
  .lang-btn {
    width: auto;
    padding-inline: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
  }

  /* Mobile nav row: scrollable, no visible scrollbar */
  .mobile-nav {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-nav::-webkit-scrollbar {
    display: none;
  }

  /* Theme icons: only the icon matching [data-theme] is shown */
  #theme-toggle .icon-system,
  #theme-toggle .icon-light,
  #theme-toggle .icon-dark {
    display: none;
  }

  :global(html[data-theme='light']) #theme-toggle .icon-light,
  :global(html[data-theme='dark']) #theme-toggle .icon-dark,
  :global(html[data-theme='system']) #theme-toggle .icon-system {
    display: inline-block;
  }

  /* Palette icons: flame (fire) or waves (abyss), following [data-palette] */
  #palette-toggle .icon-fire,
  #palette-toggle .icon-abyss {
    display: none;
  }

  :global(html[data-palette='fire']) #palette-toggle .icon-fire,
  :global(html[data-palette='abyss']) #palette-toggle .icon-abyss {
    display: inline-block;
  }
</style>

<script>
  const header = document.getElementById('site-header')
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  // Remember the language picked with the toggle (read by the root redirect)
  const langToggle = document.getElementById('lang-toggle')
  if (langToggle) {
    const { lang, storageKey } = langToggle.dataset
    langToggle.addEventListener('click', () => {
      if (!lang || !storageKey) return
      try {
        localStorage.setItem(storageKey, lang)
      } catch {
        // Switching still works when storage is unavailable.
      }
    })
  }
</script>
